{
  "name": "populive-backend",
  "version": "1.0.0",
  "description": "Backend PopuLive — API, WebSocket, motore a orari",
  "main": "populive-api-server.js",
  "scripts": {
    "start": "node populive-api-server.js",
    "dev": "nodemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "prepare": "husky",
    "setup": "npm install && npm run db:up && npm run db:seed",
    "db:up": "docker compose up -d --wait && npm run db:migrate",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:seed",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js",
    "db:validate": "node scripts/db-validate-queries.js",
    "db:psql": "docker compose exec postgres psql -U populive -d populive"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "stripe": "^17.4.0",
    "twilio": "^5.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8"
  },
  "engines": {
    "node": ">=20.6"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,sql}": [
      "prettier --write --ignore-unknown"
    ]
  }
}

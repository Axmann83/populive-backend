# ============================================================
# POPULIVE — AMBIENTE DI SVILUPPO (usato da: npm run dev)
# Solo valori locali non sensibili. Le chiavi vere (Stripe, Twilio)
# NON vanno qui: mettile in un file .env (ignorato da git), che
# ha la precedenza su questo.
# ============================================================
PORT=3001

# Database locali (corrispondono a docker-compose.yml)
DATABASE_URL=postgres://populive:populive@localhost:5432/populive
REDIS_URL=redis://localhost:6379

# Firma dei token di sessione — in locale va bene qualsiasi stringa
JWT_SECRET=dev-secret-cambiami-in-produzione

# Frontend (per i redirect di Stripe dopo il pagamento)
FRONTEND_BASE_URL=http://localhost:5173

# ---- Servizi esterni: OPZIONALI in locale ----
# Twilio (OTP via SMS). Se non impostati, in locale usa il numero e
# il codice "di test" qui sotto per entrare senza SMS reali.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
APP_REVIEW_TEST_PHONE_NUMBER=+390000000000
APP_REVIEW_TEST_OTP_CODE=123456
# Solo locale: salta Twilio, QUALUNQUE numero entra con APP_REVIEW_TEST_OTP_CODE.
# Ignorato automaticamente se NODE_ENV=production.
DEV_OTP_BYPASS=true

# Stripe (pagamenti). Servono solo per testare gli acquisti.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
